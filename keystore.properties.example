# Copy to keystore.properties and fill in. That file is git-ignored - never commit it,
# and never commit the .jks keystore it points at.
#
# storeFile is resolved relative to the project root, so a keystore kept outside the
# repository should use an absolute path.
storeFile=/home/you/keys/glyphlight-release.jks
storePassword=
keyAlias=glyphlight
keyPassword=
